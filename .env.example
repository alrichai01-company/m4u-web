# ── Phase 3+ (not required to run the frontend) ───────────────────────────────
# Contact form email delivery
RESEND_API_KEY=
CONTACT_TO_EMAIL=hello@makhijatrendz.com
CONTACT_FROM_EMAIL=website@makhijatrendz.com

# AI chatbot (OpenAI)
# Get a key at https://platform.openai.com/api-keys (billing must be set up).
OPENAI_API_KEY=
# Optional override — defaults to gpt-4o-mini in code if unset.
OPENAI_MODEL=gpt-4o-mini

# GST verification (Contact form "Fetch Details" button)
# Free test key (20 requests): enter your email at https://gstincheck.co.in/
GST_API_KEY=

# Public site URL (used for metadata / OG / sitemap)
NEXT_PUBLIC_SITE_URL=https://m4u.makhijatrendz.com

# ── Admin dashboard ───────────────────────────────────────────────────────────
# Password for /admin/login. REQUIRED in production — the dev fallback is public.
ADMIN_PASSWORD=
# Secret used to sign the admin session cookie. Use a long random string.
SESSION_SECRET=

